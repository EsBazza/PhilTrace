# Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Storage (for photo evidence uploads)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Mapbox (public, client-safe)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-access-token"

# PSA PSGC API
PSA_PSGC_TOKEN="your-psa-psgc-token"

# Semaphore SMS
SEMAPHORE_API_KEY="your-semaphore-api-key"

JWT_SECRET="your-jwt-secret-min-32-chars"

CRON_SECRET="your-cron-secret-token"

# Demo Mode
DEMO_OTP_BYPASS="false"
